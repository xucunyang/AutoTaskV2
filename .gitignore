__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.env
.env.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
.coverage
coverage.xml
htmlcov/

# 运行时目录（跑一次真实调度就会生成，不该进仓库）
orchestrator/state/
orchestrator/logs/
orchestrator/events/
orchestrator/inbox/
orchestrator/backup/
orchestrator/artifacts/
# 模型用 run_cmd 留下的临时脚本（tool loop 允许python -c，拦不住写文件）。
# 这不是产物，是垃圾——模型自己验产物时顺手造的。
orchestrator/tools/
# reports/ 不忽略：chaos_*.log 与 smoke_*.log 是验收证据，要留。
# 但 alerts.jsonl 是运行时追加的日志，每次真跑都会变——它进仓库只会
# 让每轮 diff 里混进噪音，不该入库。
orchestrator/reports/alerts.jsonl
# 只想忽略每日产物的话用 orchestrator/reports/*.md 精确规则。
