{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["as_of", "data_period", "cities"],
  "properties": {
    "as_of": {
      "type": "string",
      "minLength": 4,
      "description": "报告生成日 YYYY-MM-DD"
    },
    "data_period": {
      "type": "string",
      "minLength": 4,
      "description": "这批租售比数字实际对应的统计期：写清楚是「近30天」「2026年9月」还是「最新一期挂牌」。租售比由挂牌单价与租金口径组成，必须写明口径来源的期间"
    },
    "cities": {
      "type": "array",
      "minItems": 3,
      "description": "固定三座：南京、徐州、西宁（下标顺序不限）。每座城必须给出顶20名单，因为本任务的核心就是逐城排名",
      "items": {
        "type": "object",
        "required": ["name", "top20"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "description": "城市名，逐字写「南京」「徐州」「西宁」"},
          "top20": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "description": "该城市**租售比最高**的前 20 个小区，按 rank 升序排列",
            "items": {
              "type": "object",
              "required": ["rank", "community", "district", "price_per_sqm", "rent_per_month_psm", "rr_pct", "source"],
              "properties": {
                "rank": {"type": "integer", "minimum": 1, "maximum": 20, "description": "名次，1 开始，与数组下标错开一位"},
                "community": {"type": "string", "minLength": 2, "description": "小区名称"},
                "district": {"type": "string", "minLength": 2, "description": "所属行政区，如「鼓楼区」"},
                "price_per_sqm": {"type": "number", "minimum": 1, "description": "该小区挂牌或成交单价（元/㎡，**数字不带单位**）"},
                "rent_per_month_psm": {"type": "number", "minimum": 1, "description": "该小区单方月租金（元/㎡/月，**数字不带单位**，口径同 price_per_sqm：都按挂牌或都按成交）"},
                "rr_pct": {"type": "number", "minimum": 0.1, "description": "年化租售比（%）= rent_per_month_psm×12÷price_per_sqm×100，**数字不带%号**（如写 4.5，不写「4.5%」）"},
                "source": {"type": "string", "minLength": 4, "description": "这条排名的数据来源（平台/页标签识）"}
              }
            }
          }
        }
      },
      "allOf": [
        {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "南京"}}}},
        {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "徐州"}}}},
        {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "西宁"}}}}
      ]
    },
    "notes": {
      "type": "string",
      "description": "口径说明：租售比用挂牌还是成交价、租金是不是整租口径、哪些小区查不到为什么"
    }
  }
}