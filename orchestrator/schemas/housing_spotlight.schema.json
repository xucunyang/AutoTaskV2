{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["period", "spotlight_cities", "spotlight_communities"],
  "properties": {
    "period": {
      "type": "string",
      "minLength": 4,
      "description": "本期的统计月份，写成 YYYY-MM，如「2026-09」。月度链的价值全在这一个字段上——它必须是上一个自然月，写成本月等于拿当月未完数据冒充结论"
    },
    "spotlight_cities": {
      "type": "array",
      "minItems": 3,
      "description": "表现突出的城市，≥3 个。用户要的是「重点关注一些表现比较突出的城市或者小区，把亮眼的部分罗列出来」——只给四类城市平均数等于没回答",
      "items": {
        "type": "object",
        "required": ["city", "metric", "value", "why_bright"],
        "properties": {
          "city": {"type": "string", "minLength": 2, "description": "城市名"},
          "city_tier": {"type": "string", "description": "所属能级：一线/二线/三四线/其他"},
          "metric": {"type": "string", "minLength": 2, "description": "突出的具体指标，如「二手房成交量环比」「去化周期」——写「综合表现好」不算数"},
          "value": {"type": "string", "minLength": 1, "description": "该指标的本期数值，须与正文一致"},
          "peer_rank": {"type": "string", "description": "在同能级同级别城市中的排名或分位，如「二线第3/45」。这是「亮眼」的相对性依据"},
          "why_bright": {"type": "string", "minLength": 2, "description": "为什么突出：成交放量 / 价格倒挂 / 去化最快 / 政策见效……要能对上正文里的数字"}
        }
      }
    },
    "spotlight_communities": {
      "type": "array",
      "minItems": 2,
      "description": "表现突出的小区，≥2 个。用户说的是「城市**或者**小区」，所以两侧都不设成高门槛，门禁落在合计量上——某一侧查不到时另一侧仍可铺开，不至于整条判死",
      "items": {
        "type": "object",
        "required": ["city", "district", "name", "metric", "why_bright"],
        "properties": {
          "city": {"type": "string", "minLength": 2, "description": "所属城市"},
          "district": {"type": "string", "minLength": 2, "description": "所属行政区"},
          "name": {"type": "string", "minLength": 2, "description": "小区名称"},
          "metric": {"type": "string", "minLength": 2, "description": "突出的具体指标"},
          "value": {"type": "string", "description": "该指标数值"},
          "why_bright": {"type": "string", "minLength": 2, "description": "为什么突出"}
        }
      }
    }
  }
}