{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sku_observations",
  "description": "t1 采集的 SKU 观测副产物：时序库 sku.db 的进料口。identity_hint 键序=域契约声明序（hardware: category/series/spec）；attrs_hint 的 condition/channel/source 是 aggregate_scope 分轨维度（缺了序列口径就废，入库器会整行隔离）。形状归本 Schema；condition/channel 的语义枚举归契约 attr_value_maps（入库器是唯一裁决者，本 Schema 不重复枚举——2026-10-11 五轮死信教训：双层枚举 + 模型自然变体 = 死锁）。",
  "type": "array",
  "minItems": 10,
  "items": {
    "type": "object",
    "required": ["identity_hint", "attrs_hint", "low_price", "price_date", "shop"],
    "additionalProperties": true,
    "properties": {
      "identity_hint": {
        "type": "object",
        "required": ["category", "series", "spec"],
        "additionalProperties": false,
        "properties": {
          "category": {"type": "string", "description": "显卡/CPU/主板/内存/固态硬盘"},
          "series": {"type": "string", "description": "规范型号名：RTX 5060 Ti——渠道/成色/品牌不许塞这里"},
          "spec": {"type": "string", "description": "规格：8GB/16GB×2/1TB；CPU 无规格写空串"}
        }
      },
      "attrs_hint": {
        "type": "object",
        "required": ["condition", "channel", "source"],
        "additionalProperties": true,
        "properties": {
          "condition": {"type": "string", "description": "全新/二手/官翻/展示机——写自然说法即可，入库器按契约别名映射归一"},
          "channel": {"type": "string", "description": "自营/第三方/国行单卡/百亿补贴…——写自然说法即可，入库器按契约别名映射归一（京东自营→自营等）"},
          "source": {"type": "string", "enum": ["自采", "manmanmai", "smzdm", "gwdang", "xianyi_app", "beike_app", "jd_app"]},
          "vendor": {"type": "string"},
          "grade": {"type": "string"},
          "promo_event": {"type": "string"}
        }
      },
      "low_price": {"type": "number", "exclusiveMinimum": 0, "description": "券后到手价；数字不带单位"},
      "raw_price": {"type": "number", "exclusiveMinimum": 0, "description": "券前价，页面划线价"},
      "metric": {"type": "string", "default": "price"},
      "price_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "页面标注的价格日，不得晚于采集日"},
      "shop": {
        "type": "object",
        "required": ["name", "platform"],
        "properties": {
          "name": {"type": "string"},
          "platform": {"type": "string", "description": "京东/天猫/拼多多/闲鱼…"},
          "url": {"type": "string"}
        }
      },
      "coupons": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "amount": {"type": ["number", "null"]},
            "threshold": {"type": ["number", "null"], "description": "无门槛券写 null，不要发明 0 或省略"},
            "expire": {"type": "string"}
          }
        }
      },
      "in_stock": {"type": "boolean"},
      "img_url": {"type": "string", "description": "商品/报价截图或来源页图片 URL（R22 溯源证据，可选）"},
      "source_url": {"type": "string"},
      "source_tier": {"type": "string"}
    }
  }
}